# Local runtime state — never commit
status.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Key material and certificates (bring-your-own; nothing here belongs in git)
certs/
*.pem
*.key
*.crt
*.csr
*.srl
*.p12
*.pfx
*.jks
*.der
*.cer
*.p8
*.pkcs8
*.ovpn
# What the TLS uploader writes into the data directory, and its in-flight temp names
tls-cert.pem
tls-key.pem
.tls-cert-*
.tls-key-*
# Session signing key and the first-run artefact
session.key
setup-token
*.token

# Real configuration: your topology, ports and token references
config.toml
config.local.toml
*.local.toml
config.example.toml.bak
.env
.env.*

# Logs and dumps
*.log
*.bak

# Verification artifacts (golden payloads describe a real machine's topology)
golden/
parity-*.jsonl
parity-status.db*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Build output
dist/
build/
*.spec
*.tgz

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp


# Rust build output
rust/target/
target/
